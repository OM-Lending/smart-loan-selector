generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------
// ENUMS
// --------------------------------------------------------------------
enum UserRole {
  CUSTOMER
  BROKER
  ADMIN
}

enum ApplicationStage {
  LEAD_CAPTURED
  QUOTED
  EXPIRED
  RECOMMENDATION_SENT
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  BROKER_REVIEW
  SUBMITTED_TO_LENDER
  PRE_APPROVED
  UNCONDITIONAL_APPROVED
  SETTLED
}

enum ApplicationContinuationStatus {
  DRAFT
  SUBMITTED
}

enum BrokerReviewStatus {
  NEW
  IN_REVIEW
  NEEDS_INFORMATION
  READY_TO_SUBMIT
}

enum LenderCategory {
  BIG_4
  NON_BANK
}

enum LoanGoal {
  BUY
  REFINANCE
}

enum AustralianState {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
  OT
}

enum RepaymentStructure {
  P_AND_I
  INTEREST_ONLY
}

enum RatePreference {
  VARIABLE
  FIXED
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum RelationshipStatus {
  NEVER_MARRIED
  MARRIED
  DE_FACTO
  DIVORCED
  WIDOWED
  // Retained so existing applications remain readable. New submissions only
  // accept the five current questionnaire values.
  SINGLE
  MARRIED_DE_FACTO
}

enum SyncStatus {
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
}

enum RecommendationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum RuleParseStatus {
  PARSED
  PARTIALLY_PARSED
  UNPARSED
}

enum QuoteEligibilityStatus {
  ELIGIBLE
  REVIEW_REQUIRED
  INELIGIBLE
}

enum ProductRecommendationStatus {
  INCLUDED
  EXCLUDED
}

enum AdminMatchReviewDecision {
  APPROVED
  REJECTED
}

enum PromotionSourceChangeType {
  DISCOVERED
  UPDATED
  REMOVED
}

enum PromotionReviewStatus {
  REVIEW_REQUIRED
  REVIEWED
  IGNORED
}

enum PromotionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
}

enum PromotionType {
  CASHBACK
}

enum PromotionQualificationStatus {
  QUALIFIES
  DOES_NOT_QUALIFY
  NEEDS_REVIEW
}

// --------------------------------------------------------------------
// 1. USER IDENTITY
// --------------------------------------------------------------------
model Profile {
  id              String    @id @db.Uuid
  clerkUserId     String?   @unique @map("clerk_user_id")
  email           String    @unique
  fullName        String?   @map("full_name")
  phone           String?
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  role            UserRole  @default(CUSTOMER)
  avatarUrl       String?   @map("avatar_url")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  applications                 Application[]
  matchReviews                 AdminMatchReview[]
  productRecommendationReviews LoanProduct[]      @relation("LoanProductRecommendationReviewer")

  @@map("profiles")
}

// --------------------------------------------------------------------
// 2. LENDER & SYNC AUDIT
// --------------------------------------------------------------------
model Lender {
  id       String         @id @default(uuid()) @db.Uuid
  name     String         @unique
  logoUrl  String?        @map("logo_url")
  tier     Int            @default(1)
  category LenderCategory

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products LoanProduct[]
  syncRuns LenderSyncRun[]

  @@map("lenders")
}

model LenderSyncRun {
  id          String    @id @default(uuid()) @db.Uuid
  lenderId    String    @map("lender_id") @db.Uuid
  source      String    @default("CDR")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  status SyncStatus @default(IN_PROGRESS)

  productsSeen     Int @default(0) @map("products_seen")
  productsAdded    Int @default(0) @map("products_added")
  productsDisabled Int @default(0) @map("products_disabled")
  ratesSeen        Int @default(0) @map("rates_seen")
  ratesAdded       Int @default(0) @map("rates_added")
  ratesChanged     Int @default(0) @map("rates_changed")
  ratesDisabled    Int @default(0) @map("rates_disabled")

  errorMessage String? @map("error_message") @db.Text

  lender           Lender                @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  rateHistories    LoanRateHistory[]
  productSnapshots LoanProductSnapshot[]
  quotes           ApplicationQuote[]

  @@index([lenderId, startedAt])
  @@map("lender_sync_runs")
}

// --------------------------------------------------------------------
// 3. PRODUCT & RATE
// --------------------------------------------------------------------
model LoanProduct {
  id                             String                      @id @default(uuid()) @db.Uuid
  lenderId                       String                      @map("lender_id") @db.Uuid
  externalId                     String                      @map("external_id")
  productName                    String                      @map("product_name")
  description                    String?                     @db.Text
  // Canonical product features and the full bank response are retained separately.
  features                       Json                        @default("[]")
  rawPayload                     Json                        @default("{}") @map("raw_payload")
  parseStatus                    RuleParseStatus             @default(PARSED) @map("parse_status")
  maxLvr                         Decimal?                    @map("max_lvr") @db.Decimal(5, 2)
  minLimit                       Decimal?                    @map("min_limit") @db.Decimal(12, 2)
  isActive                       Boolean                     @default(true) @map("is_active")
  recommendationStatus           ProductRecommendationStatus @default(INCLUDED) @map("recommendation_status")
  recommendationEligibilityRules Json                        @default("{}") @map("recommendation_eligibility_rules")
  recommendationNote             String?                     @map("recommendation_note") @db.VarChar(1000)
  recommendationSourceUri        String?                     @map("recommendation_source_uri") @db.Text
  recommendationReviewedAt       DateTime?                   @map("recommendation_reviewed_at")
  recommendationReviewedById     String?                     @map("recommendation_reviewed_by_id") @db.Uuid
  createdAt                      DateTime                    @default(now()) @map("created_at")
  updatedAt                      DateTime                    @updatedAt @map("updated_at")

  lender                   Lender                    @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  rates                    LoanRate[]
  constraints              LoanProductConstraint[]
  fees                     LoanProductFee[]
  rateHistories            LoanRateHistory[]
  snapshots                LoanProductSnapshot[]
  promotionSources         PromotionSourceSnapshot[]
  quotes                   ApplicationQuote[]
  recommendationReviewedBy Profile?                  @relation("LoanProductRecommendationReviewer", fields: [recommendationReviewedById], references: [id], onDelete: SetNull)

  @@unique([lenderId, externalId])
  @@index([isActive, recommendationStatus])
  @@map("loan_products")
}

model LoanRate {
  id                String          @id @default(uuid()) @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  rateType          String          @map("rate_type")
  repaymentType     String          @map("repayment_type")
  loanPurpose       String          @map("loan_purpose")
  interestRate      Decimal         @map("interest_rate") @db.Decimal(7, 4)
  minAmount         Decimal?        @map("min_amount") @db.Decimal(12, 2)
  maxAmount         Decimal?        @map("max_amount") @db.Decimal(12, 2)
  minLvr            Decimal?        @map("min_lvr") @db.Decimal(5, 2)
  maxLvr            Decimal?        @map("max_lvr") @db.Decimal(5, 2)
  fixedPeriodMonths Int?            @map("fixed_period_months")
  rateConditions    Json            @default("{}") @map("rate_conditions")
  rawRate           Json            @default("{}") @map("raw_rate")
  conditionHash     String          @map("condition_hash")
  parseStatus       RuleParseStatus @default(PARSED) @map("parse_status")

  isActive       Boolean  @default(true) @map("is_active")
  lastObservedAt DateTime @default(now()) @map("last_observed_at")
  lastSyncRunId  String?  @map("last_sync_run_id") @db.Uuid

  product LoanProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotes  ApplicationQuote[]

  @@unique([productId, conditionHash])
  @@index([productId, isActive])
  @@map("loan_rates")
}

model LoanProductConstraint {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  constraintType String          @map("constraint_type")
  numericValue   Decimal?        @map("numeric_value") @db.Decimal(18, 4)
  unit           String?
  applicability  Json            @default("{}")
  parseStatus    RuleParseStatus @default(UNPARSED) @map("parse_status")
  description    String?         @db.Text
  rawConstraint  Json            @map("raw_constraint")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  product LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, constraintType, parseStatus])
  @@map("loan_product_constraints")
}

model LoanProductFee {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  externalKey    String          @map("external_key")
  name           String
  feeType        String          @map("fee_type")
  feeMethod      String          @map("fee_method")
  amount         Decimal?        @db.Decimal(12, 2)
  currency       String          @default("AUD")
  frequency      String?
  parseStatus    RuleParseStatus @default(UNPARSED) @map("parse_status")
  additionalInfo String?         @map("additional_info") @db.Text
  rawFee         Json            @map("raw_fee")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  product LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalKey])
  @@index([productId, feeType])
  @@map("loan_product_fees")
}

model LoanProductSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  syncRunId   String   @map("sync_run_id") @db.Uuid
  contentHash String   @map("content_hash")
  rawPayload  Json     @map("raw_payload")
  observedAt  DateTime @default(now()) @map("observed_at")

  product LoanProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  syncRun LenderSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([productId, contentHash])
  @@index([productId, observedAt])
  @@index([syncRunId])
  @@map("loan_product_snapshots")
}

// Every distinct CDR cashback payload is retained as a reviewable source
// revision. The current revision is never treated as an approved promotion.
model PromotionSourceSnapshot {
  id                String                    @id @default(uuid()) @db.Uuid
  productId         String                    @map("product_id") @db.Uuid
  sourceKey         String                    @map("source_key")
  sourceHash        String                    @map("source_hash")
  changeType        PromotionSourceChangeType @map("change_type")
  sourceFeature     Json                      @map("source_feature")
  suggestedAmount   Decimal?                  @map("suggested_amount") @db.Decimal(12, 2)
  amountParseStatus RuleParseStatus           @default(UNPARSED) @map("amount_parse_status")
  reviewStatus      PromotionReviewStatus     @default(REVIEW_REQUIRED) @map("review_status")
  isCurrent         Boolean                   @default(true) @map("is_current")
  firstObservedAt   DateTime                  @default(now()) @map("first_observed_at")
  lastObservedAt    DateTime                  @default(now()) @map("last_observed_at")
  reviewedAt        DateTime?                 @map("reviewed_at")
  reviewedBy        String?                   @map("reviewed_by")

  product    LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotions Promotion[]

  @@unique([productId, sourceKey, sourceHash])
  @@index([reviewStatus, isCurrent, lastObservedAt])
  @@index([productId, sourceKey, isCurrent])
  @@map("promotion_source_snapshots")
}

// Admin-maintained normalized rules. CDR text is evidence only; only published
// rows with a reviewed source revision may affect matching or ranking.
model Promotion {
  id                     String          @id @default(uuid()) @db.Uuid
  sourceSnapshotId       String          @map("source_snapshot_id") @db.Uuid
  version                Int             @default(1)
  promotionType          PromotionType   @default(CASHBACK) @map("promotion_type")
  name                   String
  amount                 Decimal?        @db.Decimal(12, 2)
  currency               String          @default("AUD")
  requiredGoal           LoanGoal?       @map("required_goal")
  minimumLoanAmount      Decimal?        @map("minimum_loan_amount") @db.Decimal(12, 2)
  maximumLoanAmount      Decimal?        @map("maximum_loan_amount") @db.Decimal(12, 2)
  firstHomeBuyerOnly     Boolean         @default(false) @map("first_home_buyer_only")
  applicationWindowStart DateTime?       @map("application_window_start") @db.Date
  applicationWindowEnd   DateTime?       @map("application_window_end") @db.Date
  settlementWithinDays   Int?            @map("settlement_within_days")
  drawdownWithinDays     Int?            @map("drawdown_within_days")
  eligibilityRules       Json            @default("{}") @map("eligibility_rules")
  exclusionRules         Json            @default("{}") @map("exclusion_rules")
  terms                  String?         @db.Text
  validFrom              DateTime?       @map("valid_from")
  validUntil             DateTime?       @map("valid_until")
  status                 PromotionStatus @default(DRAFT)
  parseStatus            RuleParseStatus @default(UNPARSED) @map("parse_status")
  reviewedAt             DateTime?       @map("reviewed_at")
  reviewedBy             String?         @map("reviewed_by")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  sourceSnapshot PromotionSourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)

  @@unique([sourceSnapshotId, version])
  @@index([status, validFrom, validUntil])
  @@map("promotions")
}

model LoanRateHistory {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  syncRunId String @map("sync_run_id") @db.Uuid

  rateType      String  @map("rate_type")
  repaymentType String  @map("repayment_type")
  loanPurpose   String  @map("loan_purpose")
  interestRate  Decimal @map("interest_rate") @db.Decimal(7, 4)

  observedAt  DateTime @default(now()) @map("observed_at")
  contentHash String   @map("content_hash")

  sourceUpdatedAt DateTime? @map("source_updated_at")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")

  product LoanProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  syncRun LenderSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@index([productId, observedAt])
  @@index([syncRunId])
  @@map("loan_rate_history")
}

// --------------------------------------------------------------------
// 4. APPLICATION & RECOMMENDATION
// --------------------------------------------------------------------
model Application {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  goal             LoanGoal
  buySituation     String?          @map("buy_situation")
  isFirstHomeBuyer Boolean?         @map("is_first_home_buyer")
  propertyUse      String?          @map("property_use")
  propertyStatus   String?          @map("property_status")
  propertyType     String?          @map("property_type")
  propertyPostcode String?          @map("property_postcode")
  propertySuburb   String?          @map("property_suburb") @db.VarChar(100)
  propertyState    AustralianState? @map("property_state")
  purchasePrice    Decimal?         @map("purchase_price") @db.Decimal(12, 2)
  deposit          Decimal?         @map("deposit") @db.Decimal(12, 2)

  refinanceGoal        String?  @map("refinance_goal")
  cashOutPurpose       String?  @map("cash_out_purpose")
  propertyAddress      String?  @map("property_address")
  currentLender        String?  @map("current_lender")
  propertyValue        Decimal? @map("property_value") @db.Decimal(12, 2)
  currentLoanBalance   Decimal? @map("current_loan_balance") @db.Decimal(12, 2)
  currentInterestRate  Decimal? @map("current_interest_rate") @db.Decimal(7, 4)
  currentRepaymentType String?  @map("current_repayment_type")
  isFixedRate          Boolean? @map("is_fixed_rate")
  fixedRateExpiry      String?  @map("fixed_rate_expiry")

  repaymentStructure RepaymentStructure @map("repayment_structure")
  interestOnlyYears  String?            @map("interest_only_years")
  ratePreference     RatePreference     @map("rate_preference")
  fixedYears         String?            @map("fixed_years")

  employmentStatus           EmploymentStatus   @map("employment_status")
  employmentStartDate        String?            @map("employment_start_date")
  grossAnnualSalary          Decimal            @map("gross_annual_salary") @db.Decimal(12, 2)
  relationshipStatus         RelationshipStatus @map("relationship_status")
  partnerEmploymentStatus    EmploymentStatus?  @map("partner_employment_status")
  partnerEmploymentStartDate String?            @map("partner_employment_start_date")
  partnerGrossSalary         Decimal?           @map("partner_gross_salary") @db.Decimal(12, 2)
  dependents                 Int                @default(0)
  hasExistingLoans           Boolean?           @map("has_existing_loans")
  existingMonthlyRepayment   Decimal?           @map("existing_monthly_repayment") @db.Decimal(12, 2)
  hasCreditCard              Boolean?           @map("has_credit_card")
  creditCardLimit            Decimal?           @map("credit_card_limit") @db.Decimal(12, 2)
  promotionAnswers           Json               @default("{}") @map("promotion_answers")

  currentStage              ApplicationStage @default(LEAD_CAPTURED) @map("current_stage")
  recommendationPresentedAt DateTime?        @map("recommendation_presented_at")
  applyClickedAt            DateTime?        @map("apply_clicked_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  user               Profile                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  recommendationRuns RecommendationRun[]
  quotes             ApplicationQuote[]
  continuation       ApplicationContinuation?

  @@map("applications")
}

model RecommendationRun {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  rulesVersion  String  @map("rules_version")
  engineVersion String  @map("engine_version")
  algorithmHash String? @map("algorithm_hash")

  lenderDataAsOf DateTime             @map("lender_data_as_of")
  inputSnapshot  Json                 @map("input_snapshot")
  status         RecommendationStatus @default(RUNNING)

  createdAt DateTime @default(now()) @map("created_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  quotes      ApplicationQuote[]

  @@index([applicationId, createdAt])
  @@map("recommendation_runs")
}

model ApplicationQuote {
  id                  String  @id @default(uuid()) @db.Uuid
  applicationId       String  @map("application_id") @db.Uuid
  recommendationRunId String  @map("recommendation_run_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  rateId              String? @map("rate_id") @db.Uuid

  lenderName      String             @map("lender_name")
  productName     String             @map("product_name")
  quotedRate      Decimal            @map("quoted_rate") @db.Decimal(7, 4)
  quotedRateType  RatePreference     @map("quoted_rate_type")
  quotedRepayment RepaymentStructure @map("quoted_repayment")
  annualFee       Decimal?           @map("annual_fee") @db.Decimal(10, 2)

  calculatedLvr           Decimal?               @map("calculated_lvr") @db.Decimal(5, 2)
  monthlyRepayment        Decimal?               @map("monthly_repayment") @db.Decimal(12, 2)
  score                   Decimal?               @db.Decimal(8, 4)
  rank                    Int
  explanation             Json?
  eligibilityStatus       QuoteEligibilityStatus @default(REVIEW_REQUIRED) @map("eligibility_status")
  productSnapshot         Json                   @default("{}") @map("product_snapshot")
  rateSnapshot            Json                   @default("{}") @map("rate_snapshot")
  feeSnapshot             Json                   @default("{}") @map("fee_snapshot")
  promotionSnapshot       Json                   @default("[]") @map("promotion_snapshot")
  comparisonCost          Decimal?               @map("comparison_cost") @db.Decimal(12, 2)
  comparisonHorizonMonths Int?                   @map("comparison_horizon_months")
  isSelected              Boolean                @default(false) @map("is_selected")
  createdAt               DateTime               @default(now()) @map("created_at")

  sourceSyncRunId  String   @map("source_sync_run_id") @db.Uuid
  sourceObservedAt DateTime @map("source_observed_at")

  application             Application              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  recommendationRun       RecommendationRun        @relation(fields: [recommendationRunId], references: [id], onDelete: Restrict)
  product                 LoanProduct              @relation(fields: [productId], references: [id], onDelete: Restrict)
  rate                    LoanRate?                @relation(fields: [rateId], references: [id], onDelete: Restrict)
  sourceSyncRun           LenderSyncRun            @relation(fields: [sourceSyncRunId], references: [id], onDelete: Restrict)
  adminReviews            AdminMatchReview[]
  selectedForContinuation ApplicationContinuation? @relation("ContinuationQuote")

  @@index([applicationId])
  @@index([recommendationRunId])
  @@map("application_quotes")
}

model ApplicationContinuation {
  id              String                        @id @default(uuid()) @db.Uuid
  applicationId   String                        @unique @map("application_id") @db.Uuid
  selectedQuoteId String                        @unique @map("selected_quote_id") @db.Uuid
  status          ApplicationContinuationStatus @default(DRAFT)
  reviewStatus    BrokerReviewStatus            @default(NEW) @map("review_status")
  brokerNote      String?                       @map("broker_note") @db.VarChar(2000)
  details         Json                          @default("{}")
  startedAt       DateTime                      @default(now()) @map("started_at")
  submittedAt     DateTime?                     @map("submitted_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  selectedQuote ApplicationQuote      @relation("ContinuationQuote", fields: [selectedQuoteId], references: [id], onDelete: Restrict)
  documents     ApplicationDocument[]

  @@index([selectedQuoteId])
  @@map("application_continuations")
}

model ApplicationDocument {
  id             String   @id @default(uuid()) @db.Uuid
  continuationId String   @map("continuation_id") @db.Uuid
  category       String   @db.VarChar(60)
  fileName       String   @map("file_name") @db.VarChar(255)
  contentType    String   @map("content_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  storagePath    String   @unique @map("storage_path") @db.VarChar(500)
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  continuation ApplicationContinuation @relation(fields: [continuationId], references: [id], onDelete: Restrict)

  @@index([continuationId, category])
  @@map("application_documents")
}

model AdminMatchReview {
  id                String                   @id @default(uuid()) @db.Uuid
  quoteId           String                   @map("quote_id") @db.Uuid
  reviewerProfileId String                   @map("reviewer_profile_id") @db.Uuid
  decision          AdminMatchReviewDecision
  note              String?                  @db.VarChar(2000)
  createdAt         DateTime                 @default(now()) @map("created_at")

  quote    ApplicationQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  reviewer Profile          @relation(fields: [reviewerProfileId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt])
  @@index([reviewerProfileId, createdAt])
  @@map("admin_match_reviews")
}
